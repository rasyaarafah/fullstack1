datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("TEACHER")
  image     String?  @db.LongText
  createdAt DateTime @default(now()) @map("created_at")
  letters   Letter[]

  @@map("users")
}

model Letter {
  id              String   @id @default(uuid())
  title           String // e.g., "Surat Undangan Rapat Orang Tua"
  letterNumber    String? // Optional until approved by Admin
  recipient       String
  subject         String?
  body            String   @db.Text
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?  @db.Text
  authorId        Int
  author          User     @relation(fields: [authorId], references: [id])
  createdAt       DateTime @default(now())
}

model Template {
  id           String   @id @default(uuid())
  title        String
  category     String?
  description  String?
  placeholders String   @db.Text
  bodyContent  String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")    

  @@map("templates")
}

model Notice {
  id             String       @id @default(uuid())
  targetAudience String       @map("target_audience")
  targetUsers    String?      @map("target_users") @db.Text
  message        String       @db.Text
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  noticeReads    NoticeRead[]

  @@map("notices")
}

model NoticeRead {
  id       String   @id @default(uuid())
  noticeId String   @map("notice_id")
  username String
  hasRead  Boolean  @default(true) @map("has_read")
  readAt   DateTime @default(now()) @map("read_at")

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, username])
  @@map("notice_reads")
}
