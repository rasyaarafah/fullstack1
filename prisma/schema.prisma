datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("TEACHER")
  image     String?  @db.LongText
  createdAt DateTime @default(now()) @map("created_at")
  letters   Letter[]

  @@map("users")
}

model Letter {
  id              String    @id @default(uuid())
  title           String // e.g., "Surat Undangan Rapat Orang Tua"
  letterNumber    String? // Optional until approved by Admin
  recipient       String
  subject         String?
  body            String    @db.Text
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?   @db.Text
  leftLogo        String?
  rightLogo       String?
  // Snapshot of who signed this specific letter, taken from the template
  // at creation time. Kept here (not just read live off Template) so a
  // later change to a template's signer doesn't retroactively change
  // letters that were already issued.
  signerName      String?
  signerRole      String?
  templateId      String?
  template        Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  authorId        Int
  author          User      @relation(fields: [authorId], references: [id])
  createdAt       DateTime  @default(now())

  @@map("letters")
}

model Template {
  id           String            @id @default(uuid())
  title        String
  category     String?           @default("Surat Keterangan")
  description  String?           @db.Text 
  placeholders String            @db.Text
  bodyContent  String            @db.Text
  // Who signs letters generated from this template. Nullable so existing
  // rows fall back to KOP_SURAT_DEFAULTS.defaultSignerName/Role in code
  // until an admin sets them explicitly.
  signerName   String?
  signerRole   String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  letters      Letter[]
  versions     TemplateVersion[]

  @@map("templates")
}

// Snapshot of a Template's fields, saved automatically right before
// each edit so previous versions are never lost.
model TemplateVersion {
  id           String   @id @default(uuid())
  templateId   String   @map("template_id")
  title        String
  category     String?
  description  String?  @db.Text
  placeholders String   @db.Text
  bodyContent  String   @db.Text
  signerName   String?
  signerRole   String?
  savedAt      DateTime @default(now()) @map("saved_at")

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_versions")
}

model Notice {
  id             String       @id @default(uuid())
  targetAudience String       @map("target_audience")
  targetUsers    String?      @map("target_users") @db.Text
  message        String       @db.Text
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  noticeReads    NoticeRead[]

  @@map("notices")
}

model NoticeRead {
  id       String   @id @default(uuid())
  noticeId String   @map("notice_id")
  username String
  hasRead  Boolean  @default(true) @map("has_read")
  readAt   DateTime @default(now()) @map("read_at")

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, username])
  @@map("notice_reads")
}
